# Preencha somente os provedores que deseja habilitar e salve como .env.
# Nunca envie o arquivo .env ao repositório.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Modelos corporativos ou outros endpoints compatíveis com OpenAI.
# A chave informada em api_key_env também deve existir neste arquivo e ser
# repassada na seção environment do docker-compose.yml.
# AI_GATEWAY_MODELS=[{"id":"corporativo","name":"Modelo corporativo","provider":"openai-compatible","model":"modelo-id","base_url":"https://gateway.exemplo.com/v1","api_key_env":"CORPORATE_API_KEY"}]
